# ─── Secrets ─── (NEVER commit)
.env
.env.notarize

# ─── Trained models ─── (heavy, regenerable from training; distributed via HF / GitHub Releases)
models/

# ─── Run artifacts ─── (logs, plots, metrics, Trainer checkpoints, W&B)
experiments/
wandb/

# ─── Datasets ─── (downloaded or generated by src/data_pipeline/)
dataset/raw/
dataset/synthetic/*
dataset/processed/
dataset/validation/*
dataset/subsets/
dataset/contributions/

# Due eccezioni, e solo queste: senza, un pod appena clonato non puo' riprodurre
# i corpora e ogni numero misurato altrove smette di valere.
#   - la banca dei template (136 KB di prosa con soli segnaposto, nessun dato reale
#     per costruzione): e' l'86% dei 196 template, il resto e' scritto nel codice.
#     Con --seed 42 la generazione e' deterministica, quindi banca versionata =
#     corpora riproducibili byte per byte.
#   - l'impronta del test congelato, che decide la sostituzione del modello: se
#     viaggia col codice, il preflight puo' accorgersi che il file e' cambiato.
# Il contenuto dei corpora resta fuori: si rigenera, o si copia a mano (il pool di
# ripasso, che nasce dalle 745k righe delle quattro fonti).
!dataset/synthetic/security_templates.json
!dataset/validation/test_congelato.sha256
!dataset/validation/test_riserva.sha256

# ─── Desktop app build — PyInstaller ───
build/
dist/
installer_out/
build_env/

# ─── Desktop app build — Tauri ───
tauri/node_modules/
tauri/src-tauri/target/
tauri/src-tauri/gen/
# bundled Python sidecar (~1.8 GB, regenerated by build_sidecar.spec)
tauri/src-tauri/backend/

# ─── Python ───
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ─── OS / editor cruft ───
.DS_Store
Thumbs.db
*.log

# ─── File di scope (chi e' cliente, chi e' avversario) ───
# Vivono FUORI dalla repo, uno per ingaggio: elencano gli indirizzi del cliente e
# gli indicatori dell'avversario. Questa e' solo una rete, non il posto giusto.
scope.json
*.scope.json
# `dataset/validation/` era ripetuta qui: essendo l'ultima regola vinceva su quella
# in cima, e annullava in silenzio l'eccezione per l'impronta del test congelato.
# La riga sopra basta; questa e' rimossa, non spostata.
